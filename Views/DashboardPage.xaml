<Page
    x:Class="ModemController.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentDialog
            x:Name="DlgEditProfile"
            Title="Edit Dial-up Profile"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            PrimaryButtonText="Save">
            <StackPanel Margin="0,8,0,0" Spacing="8">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Nomor Dial / Access Number:" />
                <TextBox
                    x:Name="TxtDialNumber"
                    PlaceholderText="*99***1# or *99#"
                    Text="*99***1#" />
            </StackPanel>
        </ContentDialog>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock
                    FontWeight="Bold"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Modem Status" />
                <TextBlock
                    x:Name="TxtPortInfo"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Scanning ports..." />
            </StackPanel>

            <Button
                x:Name="BtnRefresh"
                Grid.Column="1"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Click="BtnRefresh_Click"
                ToolTipService.ToolTip="Refresh Signal/Port">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                            Glyph="&#xE870;" />
                        <TextBlock
                            x:Name="TxtSignalPercent"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="0%" />
                    </StackPanel>

                    <TextBlock
                        x:Name="TxtOperatorName"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Unknown" />
                </Grid>

                <ProgressBar
                    x:Name="ProgSignal"
                    Height="6"
                    Maximum="100"
                    Value="0" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="TxtRasStatus"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Status: Standby"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        x:Name="BtnEditProfile"
                        Grid.Column="1"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnEditProfile_Click"
                        ToolTipService.ToolTip="Edit Dial Profile">
                        <FontIcon FontSize="12" Glyph="&#xE713;" />
                    </Button>
                </Grid>

                <Button
                    x:Name="BtnConnectRas"
                    HorizontalAlignment="Stretch"
                    Click="BtnConnectRas_Click"
                    Content="Connect Internet"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Padding="12,8,12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE701;" />
                    <TextBlock
                        x:Name="TxtWifiStatus"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="WiFi Hotspot" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="ToggleWifi"
                    Grid.Column="1"
                    MinWidth="0"
                    Margin="0,-6,0,-6"
                    HorizontalAlignment="Right"
                    OffContent=""
                    OnContent=""
                    Toggled="ToggleWifi_Toggled" />
            </Grid>
        </Border>
    </Grid>
</Page>