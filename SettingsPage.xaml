<Page
    x:Class="ModemController.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock FontSize="28" FontWeight="Bold" Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Configure application behavior and modem storage."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Window" />
                    <ToggleSwitch x:Name="ToggleStartup" Header="Start at startup" Toggled="ToggleStartup_Toggled" />
                    <ToggleSwitch x:Name="ToggleMinimizeToTray" Header="Minimize to tray" Toggled="ToggleMinimizeToTray_Toggled" />
                    <ToggleSwitch x:Name="ToggleCloseToTray" Header="Close to tray" Toggled="ToggleCloseToTray_Toggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="When enabled, the app remains running in the notification area."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="SMS" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Delete all SMS messages currently stored in the modem's SIM memory."
                        TextWrapping="Wrap" />
                    <Button x:Name="BtnClearSms" Content="Clear SMS Storage" Click="BtnClearSms_Click" HorizontalAlignment="Left" />
                    <Button x:Name="BtnClearMessageHistory" Content="Clear Local Message History" Click="BtnClearMessageHistory_Click" HorizontalAlignment="Left" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Local message history is stored in SQLite and remains available after messages are removed from the modem."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Modem" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Automatic port detection is always enabled so the controller can recover when the modem changes COM ports."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
